<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Link Test</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #087cf5;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .box {
            background: white;
            width: 90%;
            max-width: 400px;
            padding: 30px;
            border-radius: 20px;
        }
        h1 {
            text-align: center;
            color: #087cf5;
        }
        label {
            display: block;
            margin-top: 20px;
            margin-bottom: 8px;
            color: black;
            font-weight: bold;
        }
        input {
            display: block;
            width: 100%;
            height: 48px;
            padding: 10px;
            border: 2px solid #777;
            border-radius: 8px;
            background: white;
            color: black;
            font-size: 16px;
        }
        button {
            width: 100%;
            margin-top: 25px;
            padding: 14px;
            background: #087cf5;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 17px;
            font-weight: bold;
        }
        #status {
            margin-top: 20px;
            text-align: center;
            color: black;
        }
        #counter {
            margin-top: 10px;
            text-align: center;
            color: black;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>Link Test</h1>
        <label for="url">Link</label>
        <input
            id="url"
            type="url"
            placeholder="https://deine-testseite.de"
        >
        <label for="amount">Wie oft testen?</label>
        <input
            id="amount"
            type="number"
            min="1"
            max="100"
            value="10"
        >
        <button onclick="startTest()">
            Test starten
        </button>
        <div id="status">Bereit</div>
        <div id="counter">0 / 10</div>
    </div>
    <script>
        async function startTest() {
            const url = document.getElementById("url").value;
            const amount = Number(document.getElementById("amount").value);
            if (!url) {
                document.getElementById("status").textContent =
                    "Bitte einen Link eingeben.";
                return;
            }
            document.getElementById("status").textContent =
                "Test läuft...";
            for (let i = 1; i <= amount; i++) {
                try {
                    const response = await fetch(url, {
                        method: "GET",
                        mode: "cors",
                        cache: "no-store"
                    });
                    console.log("Test:", i, "Status:", response.status);
                } catch (error) {
                    console.log("Fehler:", error);
                }
                document.getElementById("counter").textContent =
                    i + " / " + amount;
                if (i < amount) {
                    await new Promise(resolve =>
                        setTimeout(resolve, 120000)
                    );
                }
            }
            document.getElementById("status").textContent =
                "Test beendet.";
        }
    </script>
</body>
</html>
